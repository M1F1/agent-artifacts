{
  "schema_version": 2,
  "protocol_version": 2,
  "artifact": "mcp/atlassian",
  "purpose": "Store an Atlassian API token and expose it to the harness shell.",
  "platforms": ["darwin"],
  "help_urls": [
    { "label": "Create an API token", "url": "https://example.test/atlassian/tokens" }
  ],
  "required_tools": ["/usr/bin/security"],
  "capabilities": ["keychain", "filesystem"],
  "inputs": [
    {
      "id": "api_token",
      "type": "secret",
      "prompt": "Paste the Atlassian API token",
      "help_url": "https://example.test/atlassian/tokens"
    }
  ],
  "steps": [
    {
      "id": "token",
      "use": "macos-keychain.store@1",
      "with": {
        "input": "api_token",
        "service": "aart/mcp/atlassian",
        "account": "default"
      }
    },
    {
      "id": "shell",
      "use": "shell.env-from-keychain@1",
      "with": {
        "file": "~/.zshrc",
        "variables": {
          "ATLASSIAN_API_TOKEN": {
            "service": "aart/mcp/atlassian",
            "account": "default"
          }
        }
      }
    }
  ]
}
