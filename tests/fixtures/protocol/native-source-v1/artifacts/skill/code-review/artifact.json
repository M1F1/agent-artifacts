{
  "schema_version": 1,
  "type": "skill",
  "name": "code-review",
  "version": "1.0.0",
  "summary": "Review code changes with a repeatable quality checklist.",
  "payload": {
    "root": "payload",
    "format": "aart-skill-v1"
  },
  "compatibility": {
    "profiles": ["claude", "tabnine"],
    "platforms": ["darwin", "linux"]
  },
  "install": {
    "scopes": ["project", "user"],
    "modes": ["copy", "symlink"],
    "effects": ["copy-tree"]
  },
  "authors": ["AART maintainers"],
  "license": "MIT",
  "homepage": "https://github.com/M1F1/agent-artifacts",
  "com.m1f1.runtime-requirements": {
    "schema_version": 1,
    "requirements": [
      {
        "id": "python",
        "version": {"min_inclusive": "3.11.0"},
        "reason": "The fixture models an artifact that uses Python 3.11 stdlib features."
      }
    ]
  }
}
