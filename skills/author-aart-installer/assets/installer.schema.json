{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-artifacts.example/schemas/setup-installer-v1.json",
  "title": "aart declarative setup installer v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "artifact",
    "purpose",
    "platforms",
    "help_urls",
    "required_tools",
    "capabilities",
    "inputs",
    "steps"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "protocol_version": {"const": 1},
    "artifact": {"type": "string", "pattern": "^(skill|hook|mcp)/[A-Za-z0-9._-]+$"},
    "purpose": {"$ref": "#/$defs/singleLine"},
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"const": "darwin"}
    },
    "help_urls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url"],
        "properties": {
          "label": {"$ref": "#/$defs/singleLine"},
          "url": {"type": "string", "format": "uri", "pattern": "^https://"}
        }
      }
    },
    "required_tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/singleLine"}
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["keychain", "filesystem", "docker", "network", "process", "custom-code"]
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "prompt"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "type": {"const": "secret"},
          "prompt": {"$ref": "#/$defs/singleLine"},
          "help_url": {"type": "string", "format": "uri", "pattern": "^https://"}
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "use", "with"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "use": {
            "enum": [
              "macos-keychain.store@1",
              "shell.env-from-keychain@1",
              "file.managed-block@1",
              "json.managed-merge@1",
              "directory.create@1",
              "docker.pull@1",
              "command.verify@1",
              "restart.notice@1"
            ]
          },
          "with": {"type": "object"}
        }
      }
    },
    "custom_entrypoint": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
  },
  "$defs": {
    "singleLine": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$"}
  }
}
